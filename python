import gradio as gr
import pandas as pd

#store all learner records
learners = []

#create learner class
class Learner:
    def __init__(self, learner_id, name, completed_modules, scores):
        self.learner_id = learner_id
        self.name = name
        self.completed_modules = completed_modules
        self.scores = scores

    # Method to calculate learner average
    def calculate_average(self):
        return sum(self.scores) / len(self.scores)

    # Predict performance based on average score
    def predict_performance(self):
        average = self.calculate_average()
        if average >= 80:
            return "Excellent"
        elif average >= 65:
            return "Good"
        elif average >= 50:
            return "Average"
        else:
            return "Needs Improvement"

# summary table for learner information
def show_learners():
    if len(learners) == 0:
        return pd.DataFrame(columns=[
            "Learner ID",
            "Name",
            "Completed Modules",
            "Scores",
            "Average",
            "Performance"
        ])

    # funtional map() + lambda
    #convert learner data into table using map() + lamda
    records = list(map(lambda learner: {
        "Learner ID": learner.learner_id,
        "Name": learner.name,
        "Completed Modules": ", ".join(learner.completed_modules),
        "Scores": ", ".join(map(str, learner.scores)),
        "Average": round(learner.calculate_average(), 2),
        "Performance": learner.predict_performance()
    }, learners))

    # pandas DataFrame
    return pd.DataFrame(records)

#input validation if empty data
def add_learner(learner_id, name, modules_text, scores_text):
    learner_id = learner_id.strip()
    name = name.strip()
    modules_text = modules_text.strip()
    scores_text = scores_text.strip()

    # Validation 1: Empty learner ID or name
    if learner_id == "" or name == "":
        return "Learner ID and name cannot be empty.", show_learners()

    # Validation 2: Learner ID must be a number
    try:
        learner_id_number = int(learner_id)
    except:
        return "Learner ID must be a number.", show_learners()

    # Validation 3: Duplicate learner ID
    for learner in learners:
        if learner.learner_id == learner_id_number:
            return "Learner ID already exists.", show_learners()

    # Validation 4: Completed modules cannot be empty
    if modules_text == "":
        return "Please enter at least one completed module.", show_learners()

    # Split completed modules using comma
    completed_modules = [
        module.strip()
        for module in modules_text.split(",")
        if module.strip() != ""
    ]

    # Check duplicate modules
    if len(completed_modules) != len(set(completed_modules)):
        return "The same module cannot be entered twice.", show_learners()

    # Validation 5: Scores cannot be empty
    if scores_text == "":
        return "Please enter learner scores.", show_learners()

    # Convert scores into numbers
    try:
        scores = [
            float(score.strip())
            for score in scores_text.split(",")
        ]
    except:
        return "Scores must be numbers.", show_learners()

    # Validation 6: Score range
    for score in scores:
        if score < 0 or score > 100:
            return "Score must be between 0 and 100.", show_learners()

    # Create learner object
    new_learner = Learner(
        learner_id_number,
        name,
        completed_modules,
        scores
    )

    learners.append(new_learner)

    return "Learner added successfully.", show_learners()

def analyse_learners():
    if len(learners) == 0:
        return "No learner data available."

    # Select learners with average >= 80 using filter and lambda
    high_achievers = list(filter(
        lambda learner: learner.calculate_average() >= 80,
        learners
    ))

    # Create a list of all learner averages
    averages = [
        learner.calculate_average()
        for learner in learners
    ]

    class_average = sum(averages) / len(averages)

    # Ranking using lambda
    ranked_learners = sorted(
        learners,
        key=lambda learner: (
            -learner.calculate_average(),
            learner.learner_id
        )
    )

    # Integrated output
    result = "LEARNER PERFORMANCE ANALYSIS\n\n"

    result += f"Total Learners: {len(learners)}\n"
    result += f"Class Average: {class_average:.2f}\n\n"

    # Filtered result
    result += "HIGH-ACHIEVING LEARNERS (Average >= 80)\n"

    if len(high_achievers) == 0:
        result += "None\n"
    else:
        for learner in high_achievers:
            result += (
                f"{learner.learner_id} "
                f"{learner.name} - "
                f"{learner.calculate_average():.2f}\n"
            )

    # Ranked result
    result += "\nLEARNER RANKING\n"

    for position, learner in enumerate(ranked_learners, start=1):
        result += (
            f"{position}. "
            f"{learner.learner_id} "
            f"{learner.name} - "
            f"{learner.calculate_average():.2f} - "
            f"{learner.predict_performance()}\n"
        )

    return result

# Clear input fields
def clear_input():
    return "", "", "", "", ""

# WEB INTERFACE
with gr.Blocks() as demo:

    gr.Markdown("# Integrated Learner Dashboard")
    gr.Markdown("### Smart Learning Pathway and Certification System")

    gr.Markdown("## Learner Information")

    learner_id_input = gr.Textbox(
        label="Learner ID",
        placeholder="Example: 101"
    )

    name_input = gr.Textbox(
        label="Learner Name",
        placeholder="Example: Ali"
    )

    modules_input = gr.Textbox(
        label="Completed Modules",
        placeholder="Example: programming, database"
    )

    scores_input = gr.Textbox(
        label="Scores",
        placeholder="Example: 85, 90, 95"
    )

    with gr.Row():

        add_button = gr.Button(
            "Add Learner",
            variant="primary"
        )

        clear_button = gr.Button(
            "Clear"
        )

    message = gr.Textbox(
        label="Message"
    )

    # Pandas learner summary
    gr.Markdown("## Learner Summary")

    output_table = gr.Dataframe(
        value=show_learners(),
        interactive=False
    )

    gr.Markdown("## Performance Analysis")

    analyse_button = gr.Button(
        "Analyse Learners"
    )

    analysis_output = gr.Textbox(
        label="Analysis Result",
        lines=12
    )

    # Button actions
    add_button.click(
        fn=add_learner,
        inputs=[
            learner_id_input,
            name_input,
            modules_input,
            scores_input
        ],
        outputs=[
            message,
            output_table
        ]
    )

    clear_button.click(
        fn=clear_input,
        inputs=[],
        outputs=[
            learner_id_input,
            name_input,
            modules_input,
            scores_input,
            message
        ]
    )

    analyse_button.click(
        fn=analyse_learners,
        inputs=[],
        outputs=analysis_output
    )

demo.launch(debug=True)
